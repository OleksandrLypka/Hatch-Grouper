<Window x:Class="HatchGrouper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Групування ніш для ревізійних люків" Height="640" Width="1240">
    <!-- All visible texts are (re)assigned from Localization.cs in MainWindow.UpdateTexts() -->
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: pasted list of niches -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock x:Name="InputLabel" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBox x:Name="InputBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
        </DockPanel>

        <!-- Right: settings, buttons, result -->
        <DockPanel Grid.Column="1">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="WidthRowPrefix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                <TextBlock x:Name="GapLabel" VerticalAlignment="Center" />
                <TextBox x:Name="GapBox" Text="5" Width="40" Margin="4,0,12,0" />
                <TextBlock x:Name="TrimLabel" VerticalAlignment="Center" />
                <TextBox x:Name="TrimBox" Text="60" Width="40" Margin="4,0,12,0" />
                <TextBlock x:Name="LapLabel" VerticalAlignment="Center" />
                <TextBox x:Name="LapBox" Text="25" Width="40" Margin="4,0,12,0" />
                <TextBlock x:Name="HatchLabel" VerticalAlignment="Center" />
                <TextBox x:Name="HatchDiffWBox" Text="131.6" Width="44" Margin="4,0,2,0" />
                <TextBlock Text="/" VerticalAlignment="Center" Margin="0,0,2,0" />
                <TextBox x:Name="HatchDiffHBox" Text="131.2" Width="44" Margin="0,0,12,0" />
                <TextBlock x:Name="EarLabel" VerticalAlignment="Center" />
                <TextBox x:Name="EarBox" Text="1" Width="40" Margin="4,0,12,0" />
            </WrapPanel>
            <WrapPanel x:Name="HeightParamsPanel" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="HeightRowPrefix" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="GapHLabel" VerticalAlignment="Center" />
                <TextBox x:Name="GapHBox" Text="5" Width="40" Margin="4,0,12,0" />
                <TextBlock x:Name="TrimHLabel" VerticalAlignment="Center" />
                <TextBox x:Name="TrimHBox" Text="60" Width="40" Margin="4,0,12,0" />
                <TextBlock x:Name="LapHLabel" VerticalAlignment="Center" />
                <TextBox x:Name="LapHBox" Text="25" Width="40" Margin="4,0,12,0" />
            </WrapPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="GroupButton" Click="Group_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="VisualizerButton" Click="Visualizer_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="ExtremesButton" Click="Extremes_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="OpenButton" Click="Open_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Click="Save_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="ExportButton" Click="Export_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="SettingsButton" Click="Settings_Click" Padding="12,4" Margin="0,0,8,0" />
                <Button x:Name="HelpButton" Click="Help_Click" Padding="12,4" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" />
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="ResultGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding No}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Count}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Niche}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Box}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding WithTrim}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Hatch}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding MaxGap}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Lap}" IsReadOnly="True" />
                    <DataGridTextColumn Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" MinWidth="75" Width="Auto" />
                    <DataGridTextColumn Binding="{Binding Composition}" IsReadOnly="True" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
