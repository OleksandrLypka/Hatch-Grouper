<Window x:Class="HatchGrouper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Texts and combo items are filled from Localization.cs in the constructor -->
    <StackPanel Margin="12">
        <TextBlock x:Name="UnitsHeader" FontWeight="Bold" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="180" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="InputUnitLabel" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="InputUnitBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock x:Name="ParamUnitLabel" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="ParamUnitBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock x:Name="DisplayUnitLabel" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="DisplayUnitBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock x:Name="ToleranceLabel" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="ToleranceBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock x:Name="RoundingLabel" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox x:Name="RoundingBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" />
            <TextBlock x:Name="LanguageLabel" Grid.Row="5" VerticalAlignment="Center" Margin="0,6,12,0" />
            <ComboBox x:Name="LanguageBox" Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" />
        </Grid>
        <TextBlock x:Name="NoteText" TextWrapping="Wrap" MaxWidth="420" Foreground="Gray" Margin="0,0,0,8" />
        <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" IsDefault="True" Width="80" Margin="0,0,8,0" Click="Ok_Click" />
            <Button x:Name="CancelButton" IsCancel="True" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
