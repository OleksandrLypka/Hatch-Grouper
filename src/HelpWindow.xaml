<Window x:Class="HatchGrouper.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formulas &amp; CAD Guide" Height="720" Width="850" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Content is built in the constructor from Localization.cs -->
    <DockPanel Margin="10">
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="95" Height="28"
                Margin="0,10,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        
        <TabControl x:Name="HelpTabControl">
            <TabItem x:Name="TabFormulas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel x:Name="Body" />
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabCadGuide">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel x:Name="CadBody" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
