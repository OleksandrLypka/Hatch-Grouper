<Window x:Class="HatchGrouper.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formulas" Height="640" Width="640" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Content is built in the constructor from Localization.cs -->
    <DockPanel Margin="12">
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Width="90"
                Margin="0,8,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" />
        </ScrollViewer>
    </DockPanel>
</Window>
