<Window x:Class="HatchGrouper.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Preview" Height="720" Width="960" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#0F172A" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="12,8" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="✕" Width="34" Height="28"
                        Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontWeight="Bold" FontSize="14" Click="CloseBtn_Click" ToolTip="Esc" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,14,0">
                    <Button x:Name="ZoomOutBtn" Content="➖" Width="36" Height="28" Margin="0,0,4,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ZoomOut_Click" />
                    <TextBlock x:Name="ZoomLevelText" Text="100%" Foreground="#E2E8F0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Width="55" TextAlignment="Center" />
                    <Button x:Name="ZoomInBtn" Content="➕" Width="36" Height="28" Margin="4,0,6,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ZoomIn_Click" />
                    <Button x:Name="FitBtn" Content="Fit" Width="42" Height="28" Margin="4,0,4,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="FitZoom_Click" />
                    <Button x:Name="ResetBtn" Content="1:1" Width="42" Height="28" Margin="4,0,0,0"
                            Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ResetZoom_Click" />
                </StackPanel>
                <TextBlock x:Name="HeaderTitle" Foreground="White" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,12,0" />
            </DockPanel>
        </Border>

        <!-- Bottom status / hint bar -->
        <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="12,6" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <TextBlock x:Name="BottomHintText" Foreground="#94A3B8" FontSize="11" TextAlignment="Center" />
        </Border>

        <!-- Viewport -->
        <Grid x:Name="ViewportGrid" ClipToBounds="True" Background="#090D16"
              MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp"
              MouseWheel="Viewport_MouseWheel">
            <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImageTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </DockPanel>
</Window>
