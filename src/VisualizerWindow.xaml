<Window x:Class="HatchGrouper.VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niche Grouping Map" Height="700" Width="1080" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Left: 2D Chart area with zoom/pan and controls -->
        <Border Grid.Column="0" Background="#FAFAFB" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
            <Grid x:Name="ChartHost" Background="Transparent" MouseWheel="ChartHost_MouseWheel" MouseDown="ChartHost_MouseDown" MouseMove="ChartHost_MouseMove" MouseUp="ChartHost_MouseUp">
                <Canvas x:Name="ChartCanvas" ClipToBounds="True" Background="Transparent" />

                <!-- Floating Toolbar: Zoom In / Out / Reset -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
                    <Button x:Name="ZoomInBtn" Content="+" Width="30" Height="28" Margin="0,0,4,0" FontWeight="Bold" FontSize="15" Click="ZoomIn_Click" ToolTip="Zoom in (+)" />
                    <Button x:Name="ZoomOutBtn" Content="−" Width="30" Height="28" Margin="0,0,4,0" FontWeight="Bold" FontSize="15" Click="ZoomOut_Click" ToolTip="Zoom out (−)" />
                    <Button x:Name="ResetZoomBtn" Content="⟲" Width="30" Height="28" FontWeight="Bold" FontSize="14" Click="ResetZoom_Click" />
                </StackPanel>

                <!-- Bottom Hint -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#DDF3F3F5" CornerRadius="4" Padding="8,3" Margin="0,0,0,8" IsHitTestVisible="False">
                    <TextBlock x:Name="HintText" FontSize="11" Foreground="#555560" />
                </Border>
            </Grid>
        </Border>

        <!-- Right: Legend and Group Details -->
        <Border Grid.Column="1" Background="#FDFDFE" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock x:Name="LegendHeader" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock x:Name="LegendSub" DockPanel.Dock="Top" Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                <Button x:Name="ResetFilterBtn" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="8,5" Click="ResetFilter_Click" Visibility="Collapsed" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LegendPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
