<Window x:Class="HatchGrouper.ExtremeCasesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналіз зазорів та крайні випадки" Height="660" Width="960" MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Controls: Select Group and Case -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock x:Name="GroupLabel" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="GroupCombo" MinWidth="220" SelectionChanged="GroupCombo_SelectionChanged" Margin="0,0,20,0" />

                <TextBlock x:Name="CaseLabel" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="CaseCombo" MinWidth="380" SelectionChanged="CaseCombo_SelectionChanged" />
            </WrapPanel>
        </Border>

        <!-- Main Content: Left details + Right Diagram -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Numbers, Tolerances and Conclusions -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Dimensions Card -->
                    <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="DimsHeader" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#1E293B" />
                            
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblNiche" Foreground="#64748B" />
                                <TextBlock x:Name="ValNiche" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblBox" Foreground="#64748B" />
                                <TextBlock x:Name="ValBox" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblBoxEars" Foreground="#64748B" />
                                <TextBlock x:Name="ValBoxEars" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblTrim" Foreground="#64748B" />
                                <TextBlock x:Name="ValTrim" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblHatch" Foreground="#64748B" />
                                <TextBlock x:Name="ValHatch" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Gaps Card -->
                    <Border Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="GapsHeader" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#1E293B" />

                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblGapEar" Foreground="#64748B" />
                                <TextBlock x:Name="ValGapEar" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblGapBody" Foreground="#64748B" />
                                <TextBlock x:Name="ValGapBody" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblLap" Foreground="#64748B" />
                                <TextBlock x:Name="ValLap" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock x:Name="LblHatchClr" Foreground="#64748B" />
                                <TextBlock x:Name="ValHatchClr" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Recommendations Card -->
                    <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="SummaryHeader" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#166534" />
                            <TextBlock x:Name="CaseRecommendationText" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#14532D" FontSize="12.5" />
                            <TextBlock x:Name="GlobalConclusionText" TextWrapping="Wrap" Foreground="#1E293B" FontSize="12" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: Visual Schematic Diagram -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <!-- Legend -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border Width="12" Height="12" BorderBrush="#64748B" BorderThickness="1.5" Background="#F8FAFC" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegWall" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                        <Border Width="12" Height="12" BorderBrush="#0284C7" BorderThickness="1.5" Background="#E0F2FE" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegTrim" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                        <Border Width="12" Height="12" BorderBrush="#1E293B" BorderThickness="1.5" Background="#E2E8F0" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegBox" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                        <Border Width="12" Height="12" Background="#F97316" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegEars" FontSize="11" Foreground="#475569" Margin="0,0,12,0" VerticalAlignment="Center" />

                        <Border Width="12" Height="12" BorderBrush="#0F172A" BorderThickness="1.5" Background="#FEF08A" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LegHatch" FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Interactive / Responsive Diagram Canvas -->
                    <Border Background="#FAFAFA" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4">
                        <Canvas x:Name="DiagramCanvas" ClipToBounds="True" SizeChanged="DiagramCanvas_SizeChanged" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom: Close Button -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="CloseButton" Content="Закрити" Click="Close_Click" HorizontalAlignment="Right" Padding="20,5" />
        </DockPanel>
    </Grid>
</Window>
